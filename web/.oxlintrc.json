{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/refs": "off",
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": [
    "dist/",
    "coverage/",
    "node_modules/",
    "playwright-report/",
    "test-results/",
    "src-tauri/",
    "steam-core/"
  ]
}
